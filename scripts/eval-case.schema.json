{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval-case.schema.json",
  "title": "A claude plugin eval case.yaml, as Claude Code 2.1 validates it",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1(\\.\\d+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "plugins": { "type": "array", "items": { "type": "string" } },
    "context": {
      "type": "object",
      "properties": {
        "scaffold_script": { "type": "string" },
        "history_file": { "type": "string" },
        "add_dirs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "max_turns": { "type": "integer", "minimum": 1, "maximum": 200 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "model": { "type": "string", "minLength": 1 },
        "allowed_tools": { "type": "array", "items": { "type": "string" } },
        "disallowed_tools": { "type": "array", "items": { "type": "string" } },
        "artifact_publish": { "type": "boolean" },
        "append_system_prompt": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "required": ["prompt", "model"],
      "additionalProperties": false
    },
    "runs": { "type": "integer", "minimum": 1, "maximum": 50 },
    "graders": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/grader" } },
    "expected_outcome": { "type": "string" }
  },
  "required": ["schema_version", "name", "execution", "graders"],
  "additionalProperties": false,
  "$defs": {
    "weight": { "type": "number", "exclusiveMinimum": 0 },
    "arm": { "enum": ["with-only", "both"] },
    "target": {
      "oneOf": [
        { "enum": ["trace", "last_message", "files", "mock_calls"] },
        {
          "type": "object",
          "properties": { "source": { "const": "file" }, "path": { "type": "string" } },
          "required": ["source", "path"],
          "additionalProperties": false
        }
      ]
    },
    "toolRef": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": { "tool": { "type": "string" }, "input_match": { "type": "string" } },
          "required": ["tool"],
          "additionalProperties": false
        }
      ]
    },
    "grader": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "regex" },
            "name": { "type": "string" },
            "target": { "$ref": "#/$defs/target" },
            "pattern": { "type": "string" },
            "flags": { "type": "string", "pattern": "^[dgimsuvy]*$" },
            "match": { "type": "string", "pattern": "^(contains|not_contains|count:\\d+)$" },
            "weight": { "$ref": "#/$defs/weight" },
            "arm": { "$ref": "#/$defs/arm" }
          },
          "required": ["type", "name", "pattern"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "tool_order" },
            "name": { "type": "string" },
            "before": { "$ref": "#/$defs/toolRef" },
            "after": { "$ref": "#/$defs/toolRef" },
            "weight": { "$ref": "#/$defs/weight" },
            "arm": { "$ref": "#/$defs/arm" }
          },
          "required": ["type", "name", "before", "after"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "tool_used" },
            "name": { "type": "string" },
            "tool": { "type": "string" },
            "input_match": { "type": "string" },
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 },
            "weight": { "$ref": "#/$defs/weight" },
            "arm": { "$ref": "#/$defs/arm" }
          },
          "required": ["type", "name", "tool"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "file_exists" },
            "name": { "type": "string" },
            "path": { "type": "string" },
            "exists": { "type": "boolean" },
            "weight": { "$ref": "#/$defs/weight" },
            "arm": { "$ref": "#/$defs/arm" }
          },
          "required": ["type", "name", "path"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "llm" },
            "name": { "type": "string" },
            "criteria": { "type": "string" },
            "focus": { "$ref": "#/$defs/target" },
            "weight": { "$ref": "#/$defs/weight" },
            "arm": { "$ref": "#/$defs/arm" }
          },
          "required": ["type", "name", "criteria"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "baseline" },
            "name": { "type": "string" },
            "baseline_file": { "type": "string" },
            "criteria": { "type": "string" },
            "weight": { "$ref": "#/$defs/weight" },
            "arm": { "$ref": "#/$defs/arm" }
          },
          "required": ["type", "name", "baseline_file", "criteria"],
          "additionalProperties": false
        }
      ]
    }
  }
}
