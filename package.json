{
  "name": "code-health",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "fixtures"
  ],
  "scripts": {
    "build": "node scripts/bundle.mjs && node scripts/sync-red-flags.mjs",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts/tsconfig.json",
    "check:schemas": "node scripts/check-schemas.mjs",
    "check:dist": "node scripts/bundle.mjs --check",
    "check:plugins": "node scripts/validate-plugins.mjs",
    "check": "npm run typecheck && npm test && npm run check:dist && npm run check:red-flags && npm run check:skills && npm run check:evals && npm run check:schemas && npm run check:config-schema && npm run check:plugins && npm run check:self",
    "check:red-flags": "node scripts/sync-red-flags.mjs --check",
    "check:skills": "node scripts/check-skills.mjs",
    "check:evals": "node scripts/check-evals.mjs",
    "evals": "node scripts/run-evals.mjs",
    "new-plugin": "node scripts/new-plugin.mjs",
    "check:self": "node scripts/check-self.mjs",
    "config-schema": "node scripts/config-schema.mjs",
    "check:config-schema": "node scripts/config-schema.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  },
  "license": "AGPL-3.0-only OR LicenseRef-Commercial"
}
