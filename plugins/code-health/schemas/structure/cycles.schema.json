{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cycles.schema.json",
  "title": "structure cycles --json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/analysisEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "command": {
      "const": "cycles"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "default",
            "file",
            "folder",
            "package"
          ]
        },
        "exactLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "locality": {
          "$ref": "common.schema.json#/$defs/localityInput"
        }
      },
      "required": [
        "level",
        "exactLimit",
        "locality"
      ],
      "additionalProperties": false
    },
    "population": {
      "type": "object",
      "properties": {
        "modules": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "eligibleChanges": {
          "$ref": "common.schema.json#/$defs/count"
        }
      },
      "required": [
        "modules",
        "eligibleChanges"
      ],
      "additionalProperties": false
    },
    "projectFolderCycles": {
      "type": "object",
      "description": "Present only when the structure.csharpFolderCycles setting is true and the level is default: the folder cycles whose folders are all in one C# project. They are not rows of results.",
      "properties": {
        "count": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "largest": {
          "type": "array",
          "description": "At most 3, largest first.",
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 2
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2
              },
              "project": {
                "type": "string",
                "description": "The .csproj that owns the folders."
              }
            },
            "required": [
              "id",
              "size",
              "nodes",
              "project"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "count",
        "largest"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^cycle:(default|file|folder|package):.+"
          },
          "level": {
            "enum": [
              "default",
              "file",
              "folder",
              "package"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "nested": {
            "type": "boolean",
            "description": "A folder cycle whose folders all lie on one path from the root, such as a folder and its child. Sorted after cycles with nested false. Always false at other levels."
          },
          "method": {
            "enum": [
              "exact",
              "heuristic"
            ],
            "description": "`exact` is a minimum feedback arc set. `heuristic` is Eades-Lin-Smyth, pruned to a minimal set."
          },
          "breakingSet": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/breakingEdge"
            },
            "minItems": 1
          },
          "coChangeAcross": {
            "$ref": "common.schema.json#/$defs/count"
          },
          "unblockedGain": {
            "type": [
              "number",
              "null"
            ],
            "description": "Null without a matching locality report."
          }
        },
        "required": [
          "id",
          "level",
          "size",
          "nodes",
          "nested",
          "method",
          "breakingSet",
          "coChangeAcross",
          "unblockedGain"
        ],
        "additionalProperties": false
      }
    },
    "dsm": {
      "description": "Present at the default level: the module dependency structure matrix of the language with the most modules, which the structure report draws. Null when no language has a module dependency.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "language": {
              "type": "string"
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "language": {
                    "type": "string"
                  },
                  "modules": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "language",
                  "modules"
                ],
                "additionalProperties": false
              }
            },
            "totalModules": {
              "type": "integer",
              "minimum": 0
            },
            "cycleModules": {
              "type": "integer",
              "minimum": 0
            },
            "connectedModules": {
              "type": "integer",
              "minimum": 0
            },
            "modules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Drawn modules, dependents first."
            },
            "cells": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "description": "cells[row][column]: file imports from the row module into the column module."
            },
            "againstOrder": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "layerViolations": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "start": {
                    "type": "integer"
                  },
                  "end": {
                    "type": "integer"
                  },
                  "size": {
                    "type": "integer"
                  }
                },
                "required": [
                  "label",
                  "start",
                  "end",
                  "size"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "language",
            "languages",
            "totalModules",
            "cycleModules",
            "connectedModules",
            "modules",
            "cells",
            "againstOrder",
            "layerViolations",
            "groups"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "unevaluatedProperties": false
}
