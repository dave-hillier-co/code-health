{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "files.schema.json",
  "title": "complexity files --json",
  "description": "Rows are the files with at least one measured function, by complexity, then the files with none (functions 0), by complexity. A whole-repository run on a clean tree is also stored as the complexity.files report, which the cochange plugin reads: each row's `path` and `complexity`.",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "type": "object",
  "properties": {
    "command": {
      "const": "files"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "resultsCache": { "$ref": "common.schema.json#/$defs/resultsCache" },
        "tree": {
          "$ref": "common.schema.json#/$defs/tree"
        },
        "layer": {
          "$ref": "common.schema.json#/$defs/layer"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "includeTests": {
          "type": "boolean",
          "description": "True when --include-tests listed the test files. Otherwise they are counted in dropped.tests."
        }
      },
      "required": [
        "tree",
        "layer",
        "paths",
        "includeTests"
      ],
      "additionalProperties": false
    },
    "skippedFiles": {
      "$ref": "common.schema.json#/$defs/skippedFiles"
    },
    "possibleNonProductionFolders": {
      "$ref": "common.schema.json#/$defs/possibleNonProductionFolders"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "description": "The sort key: the file's indentation complexity."
          },
          "complexity": {
            "type": "integer",
            "minimum": 0,
            "description": "Indentation complexity, the definition shared with the cochange plugin."
          },
          "source": {
            "description": "The layer that measured the file's functions, null when none were measured.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common.schema.json#/$defs/source"
              }
            ]
          },
          "profile": {
            "type": [
              "string",
              "null"
            ],
            "description": "The lexer profile of the file, if any."
          },
          "role": {
            "$ref": "common.schema.json#/$defs/role"
          },
          "unverified": {
            "type": "boolean",
            "description": "The profile came from config, so nothing measures its accuracy."
          },
          "lineCount": {
            "$ref": "common.schema.json#/$defs/count"
          },
          "codeLines": {
            "$ref": "common.schema.json#/$defs/count",
            "description": "Non-blank, non-comment lines, without the test code inside a production file (testCodeLines)."
          },
          "testCodeLines": {
            "$ref": "common.schema.json#/$defs/count",
            "description": "Code lines of test code inside a production file, such as a Rust #[cfg(test)] module. Left out of codeLines, complexity and keywordComplexity. 0 for a test file, whose lines are all in codeLines."
          },
          "keywordComplexity": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common.schema.json#/$defs/count"
              }
            ]
          },
          "functions": {
            "$ref": "common.schema.json#/$defs/count",
            "description": "Functions measured, nested ones included, without the test functions inside a production file (testFunctions)."
          },
          "testFunctions": {
            "$ref": "common.schema.json#/$defs/count",
            "description": "Functions of test code inside a production file, such as a Rust #[cfg(test)] module. Left out of functions, aggregates and aboveGuideline. 0 for a test file."
          },
          "aggregates": {
            "description": "Sum and maximum of each metric over the functions that are not inside another function. null when no function was measured.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "cognitive": {
                    "type": "object",
                    "properties": {
                      "sum": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "sum",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "cyclomatic": {
                    "type": "object",
                    "properties": {
                      "sum": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "sum",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "nesting": {
                    "type": "object",
                    "properties": {
                      "sum": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "sum",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "parameters": {
                    "type": "object",
                    "properties": {
                      "sum": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "sum",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "length": {
                    "type": "object",
                    "properties": {
                      "sum": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "sum",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "keyword": {
                    "type": "object",
                    "properties": {
                      "sum": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "sum",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "bumps": {
                    "type": "object",
                    "properties": {
                      "sum": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "sum",
                      "max"
                    ],
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "aboveGuideline": {
            "$ref": "common.schema.json#/$defs/count",
            "description": "Functions over a warn guideline."
          },
          "interfaceDepth": {
            "description": "Mean interface depth, in syntax nodes per interface element, over the file's exported top-level functions and classes. null when it exports none or has no structural adapter.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "number",
                "minimum": 0
              }
            ]
          },
          "passThroughs": {
            "$ref": "common.schema.json#/$defs/count",
            "description": "Functions whose whole body forwards to one call."
          }
        },
        "required": [
          "path",
          "score",
          "complexity",
          "source",
          "profile",
          "role",
          "unverified",
          "lineCount",
          "codeLines",
          "testCodeLines",
          "keywordComplexity",
          "functions",
          "testFunctions",
          "aggregates",
          "aboveGuideline",
          "interfaceDepth",
          "passThroughs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "skippedFiles"
  ],
  "unevaluatedProperties": false
}
