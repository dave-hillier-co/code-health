{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions for locality --json output",
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "guidelineReading": {
      "type": "object",
      "description": "A measured value beside the guideline it is read against. A ratio above 1 is past the guideline. Guidelines order and annotate results; they do not hide them.",
      "properties": {
        "value": { "type": "number" },
        "guideline": { "type": "number" },
        "ratio": { "type": "number", "minimum": 0, "description": "value divided by guideline, two decimals." }
      },
      "required": ["value", "guideline", "ratio"],
      "additionalProperties": false
    },
    "repo": {
      "type": "object",
      "properties": {
        "head": {
          "$ref": "#/$defs/sha"
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "head",
        "dirty"
      ],
      "additionalProperties": false
    },
    "truncated": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cut": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "limit",
        "total",
        "cut"
      ],
      "additionalProperties": false
    },
    "envelope": {
      "description": "Fields every document has. A command schema adds its own `command` and `results` and closes the document with unevaluatedProperties.",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "tool": {
          "const": "locality"
        },
        "command": {
          "type": "string"
        },
        "repo": {
          "$ref": "#/$defs/repo"
        },
        "config": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "inputs": {
          "type": "object"
        },
        "results": {},
        "truncated": {
          "$ref": "#/$defs/truncated"
        },
        "meta": {
          "description": "Wall-clock facts. Absent from reports and ignored by golden comparisons.",
          "type": "object"
        }
      },
      "required": [
        "schemaVersion",
        "tool",
        "command",
        "repo",
        "config",
        "inputs",
        "results",
        "truncated"
      ]
    }
  }
}
