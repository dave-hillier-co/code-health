{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analyse.schema.json",
  "title": "locality analyse --json",
  "type": "object",
  "description": "Structural analysis by default. With --source history the document is described by analyse-history.schema.json.",
  "if": { "required": ["inputs"], "properties": { "inputs": { "type": "object", "required": ["source"], "properties": { "source": { "const": "history" } } } } },
  "then": { "$ref": "analyse-history.schema.json" },
  "else": { "$ref": "#/$defs/structural" },
  "$defs": {
    "recommendation": { "enum": ["inline", "move", "split", "blocked", "keep", "scrutinise", "review"] },
    "paths": { "type": "array", "items": { "type": "string" } },
    "pathCounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "count": { "$ref": "common.schema.json#/$defs/count" }
        },
        "required": ["path", "count"],
        "additionalProperties": false
      }
    },
    "component": {
      "type": "object",
      "properties": {
        "symbols": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Qualified names of the exported units, sorted." },
        "consumers": { "$ref": "#/$defs/paths", "description": "Production files that use any of the symbols." },
        "consumerFolders": { "$ref": "#/$defs/paths" },
        "location": { "type": "string", "description": "The folder of the file the component is in." },
        "target": { "type": "string" },
        "distance": { "$ref": "common.schema.json#/$defs/count" },
        "gain": { "$ref": "common.schema.json#/$defs/count" },
        "fanIn": { "$ref": "common.schema.json#/$defs/count" },
        "lines": { "$ref": "common.schema.json#/$defs/count" },
        "recommendation": { "$ref": "#/$defs/recommendation" },
        "rule": { "type": "string" }
      },
      "required": ["symbols", "consumers", "consumerFolders"],
      "additionalProperties": false,
      "description": "The scoring fields are present when the file is mixed: each component is then scored and recommended on its own."
    },
    "structural": {
      "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
      "type": "object",
      "properties": {
        "command": { "const": "analyse" },
        "inputs": {
          "type": "object",
          "properties": {
            "entrySource": { "enum": ["config", "detected"], "description": "Where the entry points came from: the suite config's entryPoints, or the files nothing imports." },
            "entries": { "$ref": "#/$defs/paths" },
            "paths": { "$ref": "#/$defs/paths", "description": "Path prefixes the run was limited to." },
            "recommendation": { "anyOf": [{ "$ref": "#/$defs/recommendation" }, { "type": "null" }] },
            "source": { "enum": ["structural", "both"], "description": "`both` also cross-checks the import graph against co-change and lists hiddenCoupling. History alone is analyse-history.schema.json." }
          },
          "required": ["entrySource", "entries", "paths", "recommendation", "source"],
          "additionalProperties": false
        },
        "summary": {
          "type": "object",
          "properties": {
            "files": { "$ref": "common.schema.json#/$defs/count", "description": "Production source files analysed." },
            "units": { "$ref": "common.schema.json#/$defs/count", "description": "Units found, before units already near their consumers are dropped." },
            "byRecommendation": { "type": "object", "additionalProperties": { "$ref": "common.schema.json#/$defs/count" } }
          },
          "required": ["files", "units", "byRecommendation"],
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "description": "Leading indicators and the gaming check, not outcomes.",
          "properties": {
            "totalWeightedDistance": { "$ref": "common.schema.json#/$defs/count", "description": "Reference-weighted tree distance over every production dependency." },
            "singleFileFolders": { "$ref": "common.schema.json#/$defs/count" },
            "maxDepth": { "$ref": "common.schema.json#/$defs/count" }
          },
          "required": ["totalWeightedDistance", "singleFileFolders", "maxDepth"],
          "additionalProperties": false
        },
        "history": {
          "description": "What the history cache gave the analysis, or null when it was off or could not give an honest answer (a shallow clone). With a weak grade, history-based fields are tentative.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "window": {
                  "type": "object",
                  "properties": { "months": { "type": "integer", "minimum": 1 }, "since": { "type": "integer" }, "until": { "type": "integer" } },
                  "required": ["months", "since", "until"],
                  "additionalProperties": false
                },
                "grade": { "enum": ["strong", "moderate", "weak"] },
                "logicalChangesInWindow": { "$ref": "common.schema.json#/$defs/count" },
                "usableHistoryMonths": { "type": "number", "minimum": 0 },
                "activeContributors": { "$ref": "common.schema.json#/$defs/count" }
              },
              "required": ["window", "grade", "logicalChangesInWindow", "usableHistoryMonths", "activeContributors"],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "hiddenCoupling": {
          "type": "array",
          "description": "With `--source both`: units the import graph places well, whose co-change partners are all elsewhere and none of them imports or is imported by the unit.",
          "items": { "$ref": "analyse-history.schema.json#/$defs/candidate" }
        },
        "historyOnly": { "$ref": "analyse-history.schema.json#/$defs/historyOnly", "description": "With `--source both`: what the cross-check left out, or why it reported nothing." },
        "unreachable": { "$ref": "#/$defs/paths", "description": "Production files the virtual root cannot reach: dead code, or an entry point missing from config." },
        "barrels": { "$ref": "#/$defs/paths" },
        "unresolved": { "type": "object", "additionalProperties": { "$ref": "common.schema.json#/$defs/count" }, "description": "Imports the resolver could not follow, by reason." },
        "filesWithSyntaxErrors": { "$ref": "#/$defs/paths" },
        "filesWithMacroCode": { "$ref": "#/$defs/paths", "description": "Files where a macro stands in for declarations or code, which the parser does not run the preprocessor to see. Present only when there are some." },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "description": "The unit's entry file, or for a sibling-set unit its folder." },
              "score": { "$ref": "common.schema.json#/$defs/count", "description": "The gain; the unblocked gain for blocked units, the sum of the components' gains for splits, the fan-in for scrutinise." },
              "recommendation": { "$ref": "#/$defs/recommendation" },
              "rule": { "type": "string", "description": "The rule that fired, described by `locality explain <rule>`." },
              "source": { "const": "structural" },
              "unit": {
                "type": "object",
                "properties": {
                  "kind": { "enum": ["file", "branch", "sibling-set", "barrel"] },
                  "root": { "type": "string" },
                  "entries": { "$ref": "#/$defs/paths", "description": "Entry files of a sibling set." },
                  "files": { "$ref": "#/$defs/paths", "description": "Every file that moves with the unit." },
                  "tests": { "$ref": "#/$defs/paths", "description": "Tests that import only files of the unit and move with it." },
                  "cycle": { "type": "boolean", "description": "The unit contains an import cycle, so it can only move whole." }
                },
                "required": ["kind", "root", "entries", "files", "tests", "cycle"],
                "additionalProperties": false
              },
              "location": { "type": "string", "description": "The folder the unit lives in: the deepest folder holding all its files." },
              "target": { "type": "string", "description": "The folder that minimises the unit's net distance." },
              "distance": { "$ref": "common.schema.json#/$defs/count", "description": "Folder hops from location to target." },
              "gain": { "$ref": "common.schema.json#/$defs/count", "description": "Net distance saved by moving to the target as things stand." },
              "unblockedGain": { "$ref": "common.schema.json#/$defs/count", "description": "The gain if every blocker were resolved." },
              "netDistance": {
                "type": "object",
                "properties": { "current": { "$ref": "common.schema.json#/$defs/count" }, "atTarget": { "$ref": "common.schema.json#/$defs/count" } },
                "required": ["current", "atTarget"],
                "additionalProperties": false
              },
              "directCalls": { "$ref": "#/$defs/pathCounts" },
              "otherRefs": { "$ref": "#/$defs/pathCounts" },
              "testRefs": {
                "type": "object",
                "properties": { "owned": { "$ref": "#/$defs/paths" }, "external": { "$ref": "#/$defs/paths" } },
                "required": ["owned", "external"],
                "additionalProperties": false
              },
              "fanIn": { "$ref": "common.schema.json#/$defs/count", "description": "Distinct production consumer files." },
              "size": {
                "type": "object",
                "properties": {
                  "lines": { "$ref": "common.schema.json#/$defs/count" },
                  "files": { "$ref": "common.schema.json#/$defs/count" },
                  "units": { "$ref": "common.schema.json#/$defs/count", "description": "Functions, methods and classes." }
                },
                "required": ["lines", "files", "units"],
                "additionalProperties": false
              },
              "ownDeps": { "$ref": "#/$defs/paths", "description": "Production files the unit imports from outside itself." },
              "visibility": { "enum": ["exported", "package-entry"] },
              "age": { "type": ["integer", "null"], "minimum": 0, "description": "Days from the first appearance of the unit's entry file to HEAD's commit date. Null without history." },
              "lastChanged": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Latest commit date of any file of the unit." },
              "churn": { "type": ["integer", "null"], "minimum": 0, "description": "Lines added and deleted across the unit's files in the window." },
              "coChange": {
                "description": "How the unit changed with its consumers over the window. Null without history.",
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "consumers": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "path": { "type": "string" },
                            "support": { "$ref": "common.schema.json#/$defs/count", "description": "Logical changes touching the unit and the consumer." },
                            "consumerChanges": { "$ref": "common.schema.json#/$defs/count" },
                            "degree": { "type": "number", "minimum": 0, "maximum": 100 }
                          },
                          "required": ["path", "support", "consumerChanges", "degree"],
                          "additionalProperties": false
                        }
                      },
                      "amongConsumers": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Median degree between pairs of consumers. Null with fewer than locality.minCoChangeChanges changes, or with more consumers than are compared." }
                    },
                    "required": ["consumers", "amongConsumers"],
                    "additionalProperties": false
                  },
                  { "type": "null" }
                ]
              },
              "signals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "enum": ["barrel", "overexposure", "pass-through", "special-general-mixture", "vague-name"] },
                    "detail": { "type": "string" }
                  },
                  "required": ["name", "detail"],
                  "additionalProperties": false
                }
              },
              "strays": { "$ref": "#/$defs/paths", "description": "Files in the unit's neighbourhood that it depends on and that stay behind." },
              "blockers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "from": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                    "kind": { "enum": ["dependency", "stray"] },
                    "weight": { "$ref": "common.schema.json#/$defs/count" },
                    "otherConsumers": { "$ref": "common.schema.json#/$defs/count" },
                    "coChange": {
                      "description": "How the unit and the blocker changed together. Few blockerChanges means a stable dependency. Null without history.",
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "support": { "$ref": "common.schema.json#/$defs/count" },
                            "degree": { "type": "number", "minimum": 0, "maximum": 100 },
                            "blockerChanges": { "$ref": "common.schema.json#/$defs/count" }
                          },
                          "required": ["support", "degree", "blockerChanges"],
                          "additionalProperties": false
                        },
                        { "type": "null" }
                      ]
                    },
                    "unblockedGain": { "$ref": "common.schema.json#/$defs/count" }
                  },
                  "required": ["path", "from", "kind", "weight", "otherConsumers", "coChange", "unblockedGain"],
                  "additionalProperties": false
                }
              },
              "cohesion": {
                "type": "object",
                "properties": {
                  "components": { "type": "array", "items": { "$ref": "#/$defs/component" }, "minItems": 2 },
                  "mixed": { "type": "boolean" }
                },
                "required": ["components", "mixed"],
                "additionalProperties": false
              }
            },
            "required": [
              "path", "score", "recommendation", "rule", "source", "unit", "location", "target", "distance", "gain", "unblockedGain",
              "netDistance", "directCalls", "otherRefs", "testRefs", "fanIn", "size", "ownDeps", "visibility", "age", "lastChanged",
              "churn", "coChange", "signals", "strays", "blockers"
            ],
            "additionalProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    }
  }
}
