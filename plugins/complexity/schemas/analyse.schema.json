{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analyse.schema.json",
  "title": "complexity analyse --json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "type": "object",
  "properties": {
    "command": {
      "const": "analyse"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "tree": {
          "$ref": "common.schema.json#/$defs/tree"
        },
        "layer": {
          "$ref": "common.schema.json#/$defs/layer"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/metricId"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "withFixes": {
          "const": true,
          "description": "Present when --with-fixes added the fix columns."
        },
        "maxCommits": {
          "type": "integer",
          "minimum": 1,
          "description": "With --with-fixes: the most commits of the history window analysed."
        },
        "evidence": {
          "type": "integer",
          "minimum": 0,
          "description": "With --with-fixes: the evidence commits kept per function."
        }
      },
      "required": [
        "tree",
        "layer",
        "metrics",
        "paths"
      ],
      "additionalProperties": false
    },
    "ranking": {
      "type": "object",
      "properties": {
        "basis": {
          "type": "string"
        },
        "changeWeighted": {
          "type": "boolean",
          "description": "True when each unit's rank score is its complexity percentile times the change weight of its file. False when change weighting is off or history could not give an honest answer (a shallow clone), and the rank is the percentile alone."
        },
        "window": {
          "description": "The change-frequency window, back from HEAD's commit date, in unix seconds. Null when the ranking is not change-weighted.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "months": { "type": "integer", "minimum": 1 },
                "since": { "type": "integer" },
                "until": { "type": "integer" }
              },
              "required": ["months", "since", "until"],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        }
      },
      "required": [
        "basis",
        "changeWeighted",
        "window"
      ],
      "additionalProperties": false
    },
    "layers": {
      "description": "Files by the layer that measured their functions. `none` is files with no per-function metrics.",
      "type": "object",
      "properties": {
        "structural": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "lexical": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "none": {
          "$ref": "common.schema.json#/$defs/count"
        }
      },
      "required": [
        "structural",
        "lexical",
        "none"
      ],
      "additionalProperties": false
    },
    "agreement": {
      "$ref": "common.schema.json#/$defs/agreement"
    },
    "skipped": {
      "$ref": "common.schema.json#/$defs/skipped"
    },
    "parseCoverage": {
      "description": "How many of the files a grammar read have syntax errors, against the complexity.syntaxErrorPercent guideline. A notice is printed when the share is above it. Nothing is hidden.",
      "type": "object",
      "properties": {
        "parsedFiles": { "description": "Files a grammar read.", "type": "integer", "minimum": 0 },
        "filesWithSyntaxErrors": { "description": "How many of them have syntax errors.", "type": "integer", "minimum": 0 },
        "syntaxErrorShare": { "description": "filesWithSyntaxErrors over parsedFiles, 0 to 1, rounded to four decimals.", "type": "number", "minimum": 0, "maximum": 1 },
        "guideline": { "description": "The complexity.syntaxErrorPercent guideline, a percent.", "type": "number" },
        "aboveGuideline": { "type": "boolean" }
      },
      "required": ["parsedFiles", "filesWithSyntaxErrors", "syntaxErrorShare", "guideline", "aboveGuideline"],
      "additionalProperties": false
    },
    "filesWithSyntaxErrors": {
      "description": "Files whose parse reported syntax errors, so their units may be incomplete.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skippedFiles": {
      "$ref": "common.schema.json#/$defs/skippedFiles"
    },
    "fixes": {
      "description": "With --with-fixes: the header of the per-function fix statistics, as `complexity fixes` prints it.",
      "$ref": "common.schema.json#/$defs/fixHeader"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "description": "The qualified name, or <anonymous> for a lexical block without one."
          },
          "id": {
            "type": "string",
            "description": "path#Qualified.name, with ~n on duplicates."
          },
          "kind": {
            "$ref": "common.schema.json#/$defs/kind"
          },
          "startLine": {
            "type": "integer",
            "minimum": 1
          },
          "endLine": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "$ref": "common.schema.json#/$defs/source"
          },
          "unverified": {
            "const": true,
            "description": "Present when the file's lexer profile came from config (`languages`), so nothing measures the accuracy of the per-function values."
          },
          "test": {
            "type": "boolean"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The rank score: the highest percentile of any selected metric, times changeWeight when the ranking is change-weighted."
          },
          "complexityScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The highest percentile of any selected metric, before change weighting."
          },
          "revisions": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "Logical changes to the unit's file in the window. Null when the ranking is not change-weighted."
          },
          "changeWeight": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "0 for a file with no change in the window, otherwise the percentile of its revisions among the files that changed. Null when the ranking is not change-weighted."
          },
          "dominant": {
            "description": "The metric that gave the score, null for a unit with no selected metric.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common.schema.json#/$defs/metricId"
              }
            ]
          },
          "percentiles": {
            "type": "object",
            "properties": {
              "cognitive": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cyclomatic": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "nesting": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "parameters": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "length": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "keyword": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "bumps": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "labels": {
            "$ref": "common.schema.json#/$defs/labels"
          },
          "parent": {
            "type": "string",
            "description": "Qualified name of the function this one is nested in, for a nested function or lambda. Absent for a function that is not nested. A nested function also adds to its parent's score."
          },
          "statements": {
            "type": "integer",
            "minimum": 0,
            "description": "Statements in the function, nested functions' included. Reported with the length metric, which counts lines. Structural units."
          },
          "bumpDepth": {
            "type": "integer",
            "minimum": 0,
            "description": "The deepest level reached inside any bump, 0 with none. Reported with the bumps metric."
          },
          "bumpSize": {
            "type": "integer",
            "minimum": 0,
            "description": "Code lines in the largest bump. Reported with the bumps metric."
          },
          "optionCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Properties destructured out of object parameters, which count as one parameter. Structural units, with the parameters metric."
          },
          "cognitive": {
            "type": "integer",
            "minimum": 0
          },
          "cyclomatic": {
            "type": "integer",
            "minimum": 0
          },
          "nesting": {
            "type": "integer",
            "minimum": 0
          },
          "parameters": {
            "type": "integer",
            "minimum": 0
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "keyword": {
            "type": "integer",
            "minimum": 0
          },
          "bumps": {
            "type": "integer",
            "minimum": 0
          },
          "fixCommits": {
            "$ref": "common.schema.json#/$defs/count",
            "description": "With --with-fixes: logical changes in the analysed history window that are fixes and changed a line of the function."
          },
          "unitRevisions": {
            "$ref": "common.schema.json#/$defs/count",
            "description": "With --with-fixes: logical changes in the analysed window that changed a line of the function, fixes included."
          },
          "fixShare": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "With --with-fixes: fixCommits over unitRevisions. Null for a function no analysed change touched."
          }
        },
        "required": [
          "path",
          "unit",
          "id",
          "kind",
          "startLine",
          "endLine",
          "source",
          "test",
          "score",
          "complexityScore",
          "revisions",
          "changeWeight",
          "dominant",
          "percentiles",
          "labels"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ranking",
    "layers",
    "agreement",
    "skipped",
    "parseCoverage",
    "filesWithSyntaxErrors",
    "skippedFiles"
  ],
  "unevaluatedProperties": false
}
