{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions for complexity --json output",
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "repo": {
      "type": "object",
      "properties": {
        "head": {
          "$ref": "#/$defs/sha"
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "head",
        "dirty"
      ],
      "additionalProperties": false
    },
    "truncated": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cut": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "limit",
        "total",
        "cut"
      ],
      "additionalProperties": false
    },
    "envelope": {
      "description": "Fields every document has. A command schema adds its own `command` and `results` and closes the document with unevaluatedProperties.",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "tool": {
          "const": "complexity"
        },
        "command": {
          "type": "string"
        },
        "repo": {
          "$ref": "#/$defs/repo"
        },
        "config": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "inputs": {
          "type": "object"
        },
        "results": {},
        "truncated": {
          "$ref": "#/$defs/truncated"
        },
        "omittedByBuiltinExcludes": {
          "description": "Present only when a built-in exclude omitted files: the number of files each built-in entry omitted (.claude/**, .cache/**, .code-health/**, or a directory below the repository root that is its own git checkout). Entries that omitted nothing are not listed.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "dropped": {
          "description": "Present only when files were left out because of what they are: the number of distinct files left out as generated (a linguist-generated attribute or a generated-code header), as vendored (a linguist-vendored attribute or a vendor directory), and as non-code (no language adapter or lexical profile claims them, for a command that ranks only code), and as tests (a command that lists production code first, left out unless `--include-tests` is given). Kinds that left out nothing are not listed.",
          "type": "object",
          "properties": {
            "generated": { "type": "integer", "minimum": 1 },
            "vendored": { "type": "integer", "minimum": 1 },
            "nonCode": { "type": "integer", "minimum": 1 },
            "tests": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "meta": {
          "description": "Wall-clock facts. Absent from reports and ignored by golden comparisons.",
          "type": "object"
        }
      },
      "required": [
        "schemaVersion",
        "tool",
        "command",
        "repo",
        "config",
        "inputs",
        "results",
        "truncated"
      ]
    },
    "metricId": {
      "enum": [
        "cognitive",
        "cyclomatic",
        "nesting",
        "parameters",
        "length",
        "keyword",
        "bumps"
      ]
    },
    "metricValues": {
      "description": "The metrics a unit has. The structural layer gives cognitive, cyclomatic, nesting, parameters, length and bumps. The lexical layer gives nesting, length, keyword and bumps. `--metrics` leaves out the others.",
      "type": "object",
      "properties": {
        "cognitive": {
          "type": "integer",
          "minimum": 0
        },
        "cyclomatic": {
          "type": "integer",
          "minimum": 0
        },
        "nesting": {
          "type": "integer",
          "minimum": 0
        },
        "parameters": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "keyword": {
          "type": "integer",
          "minimum": 0
        },
        "bumps": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "tree": {
      "description": "What was measured: the commit at HEAD when the tree is clean, otherwise the files on disk.",
      "enum": [
        "head",
        "working-tree"
      ]
    },
    "layer": {
      "enum": [
        "auto",
        "lexical",
        "structural"
      ]
    },
    "source": {
      "description": "The layer that measured the unit.",
      "enum": [
        "structural",
        "lexical"
      ]
    },
    "labels": {
      "description": "For example cognitive-warn, cognitive-high, nesting-warn, bumpy-road.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kind": {
      "enum": [
        "function",
        "arrow",
        "method",
        "class",
        "block"
      ]
    },
    "skippedFiles": {
      "description": "Files left out of the measurement, by cause.",
      "type": "object",
      "properties": {
        "binary": {
          "$ref": "#/$defs/count"
        },
        "large": {
          "$ref": "#/$defs/count"
        },
        "excluded": {
          "$ref": "#/$defs/count"
        },
        "tests": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "binary",
        "large",
        "excluded",
        "tests"
      ],
      "additionalProperties": false
    },
    "agreement": {
      "description": "Agreement of each lexer profile with the structural layer, for the profiles whose per-function metrics were released.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "exactRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "spuriousRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bar": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "exactRate",
          "spuriousRate",
          "bar"
        ],
        "additionalProperties": false
      }
    },
    "skipped": {
      "description": "What could not be measured, with the number of files each reason applied to.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/count"
      }
    },
    "revision": {
      "description": "A revision as it was named, or how it was found, with the commit it resolved to.",
      "type": "object",
      "properties": {
        "rev": {
          "type": "string"
        },
        "sha": {
          "$ref": "#/$defs/sha"
        }
      },
      "required": [
        "rev",
        "sha"
      ],
      "additionalProperties": false
    },
    "deltaValues": {
      "type": "object",
      "properties": {
        "cognitive": {
          "type": "integer"
        },
        "cyclomatic": {
          "type": "integer"
        },
        "nesting": {
          "type": "integer"
        },
        "parameters": {
          "type": "integer"
        },
        "length": {
          "type": "integer"
        },
        "keyword": {
          "type": "integer"
        },
        "bumps": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "fixConvention": {
      "type": "object",
      "description": "The repository-level check on the fix definition: the share of logical changes in the window that are fixes. A note says the commit messages probably do not follow a convention this can use. The counts are reported either way.",
      "properties": {
        "logicalChanges": {
          "type": "integer",
          "minimum": 0
        },
        "fixes": {
          "type": "integer",
          "minimum": 0
        },
        "share": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "followsConvention": {
          "type": "boolean"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "guidelines": {
          "type": "object",
          "properties": {
            "minShare": {
              "type": "number"
            },
            "maxShare": {
              "type": "number"
            },
            "minChanges": {
              "type": "integer"
            },
            "provenance": {
              "type": "string"
            }
          },
          "required": [
            "minShare",
            "maxShare",
            "minChanges",
            "provenance"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "logicalChanges",
        "fixes",
        "share",
        "followsConvention",
        "note",
        "guidelines"
      ],
      "additionalProperties": false
    },
    "role": {
      "enum": ["production", "test"],
      "description": "Whether the code is a test: its file is named as a test by the language's conventions or by the shared testPatterns of code-health.json, or (Rust) it sits in a #[cfg(test)] module or is a #[test] function."
    },
    "testsSection": {
      "type": "object",
      "description": "Present when the rows are production code only: the tests left out of them, counted, with the first few in the same order. A run with --include-tests lists the tests in results and has no tests section.",
      "properties": {
        "count": { "$ref": "#/$defs/count" },
        "listed": { "$ref": "#/$defs/count", "description": "Rows in rows." },
        "omitted": { "$ref": "#/$defs/count", "description": "count minus listed." },
        "rows": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["count", "listed", "omitted", "rows"],
      "additionalProperties": false
    },
    "fixRow": {
      "type": "object",
      "description": "One function with its fix statistics, followed forward to the current revision. A function that no longer exists has no kind, lines or cognitive complexity.",
      "properties": {
        "path": {
          "type": "string"
        },
        "unit": {
          "type": "string",
          "description": "The qualified name."
        },
        "id": {
          "type": "string",
          "description": "path#Qualified.name."
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "description": "The sort key: fixCommits plus fixShare, so rows sort by fix count, then fix share."
        },
        "fixCommits": {
          "$ref": "#/$defs/count",
          "description": "Logical changes in the analysed window that match the shared fix definition and changed a line of the function."
        },
        "unitRevisions": {
          "$ref": "#/$defs/count",
          "description": "Logical changes in the analysed window that changed a line of the function, fixes included. A change that created the file counts once for each of its functions."
        },
        "fixShare": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "fixCommits over unitRevisions, to 3 decimals."
        },
        "cognitive": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "The function's cognitive complexity in the current revision. Null for a deleted function."
        },
        "labels": {
          "type": "array",
          "items": {
            "const": "low evidence"
          },
          "description": "`low evidence` when the function has fewer than `fixes.minRevisions` revisions in the analysed window. Such a row sorts after the others with the same fixCommits."
        },
        "evidence": {
          "type": "array",
          "description": "The fix commits, newest first, up to --evidence.",
          "items": {
            "type": "object",
            "properties": {
              "sha": {
                "$ref": "#/$defs/sha"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Committer date of the logical change."
              },
              "subject": {
                "type": "string"
              },
              "pattern": {
                "type": "string",
                "description": "The fix pattern, or the revert line, that decided the commit."
              },
              "matchedIn": {
                "enum": [
                  "subject",
                  "body"
                ]
              }
            },
            "required": [
              "sha",
              "date",
              "subject",
              "pattern",
              "matchedIn"
            ],
            "additionalProperties": false
          }
        },
        "evidenceOmitted": {
          "$ref": "#/$defs/count",
          "description": "Fix commits beyond the evidence limit."
        },
        "earlierIds": {
          "type": "array",
          "description": "Other ids the function had earlier in the window: a rename or a move.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "path",
        "unit",
        "id",
        "role",
        "score",
        "fixCommits",
        "unitRevisions",
        "fixShare",
        "cognitive",
        "labels",
        "evidence",
        "evidenceOmitted",
        "earlierIds"
      ],
      "additionalProperties": false
    },
    "fixHeader": {
      "description": "The header of the per-function fix statistics: the window, the repository-level convention check, how much history was analysed and what was left out, and the lists that are not rows.",
      "type": "object",
      "properties": {
        "window": {
          "type": "object",
          "properties": {
            "months": {
              "type": "integer",
              "minimum": 1
            },
            "since": {
              "type": "string"
            },
            "until": {
              "type": "string"
            }
          },
          "required": [
            "months",
            "since",
            "until"
          ],
          "additionalProperties": false
        },
        "shallow": {
          "type": "boolean",
          "description": "The clone is shallow, so history before its boundary is missing."
        },
        "fixConvention": {
          "$ref": "#/$defs/fixConvention"
        },
        "fixesExcluded": {
          "type": "object",
          "description": "Logical changes of the window that a fix pattern matched and an exclude pattern (history.fixExcludePatterns) removed, because the fix target is formatting, lint, typos, docs, tests or CI. They are not counted as fixes. `byPattern` counts them by the excluding pattern.",
          "properties": {
            "fixes": { "$ref": "#/$defs/count", "description": "Excluded changes." },
            "byPattern": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": { "pattern": { "type": "string" }, "count": { "$ref": "#/$defs/count" } },
                "required": ["pattern", "count"],
                "additionalProperties": false
              }
            },
            "commits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "subject": { "type": "string" },
                  "pattern": { "type": "string", "description": "The exclude pattern." },
                  "matchedIn": { "enum": ["subject", "body"] }
                },
                "required": ["id", "subject", "pattern", "matchedIn"],
                "additionalProperties": false
              }
            },
            "omitted": { "$ref": "#/$defs/count", "description": "Excluded changes beyond `commits`." },
            "excludePatterns": { "type": "string" },
            "note": { "type": "string" }
          },
          "required": ["fixes", "byPattern", "commits", "omitted", "excludePatterns", "note"],
          "additionalProperties": false
        },
        "lowEvidence": {
          "type": "object",
          "properties": {
            "minRevisions": { "type": "integer", "minimum": 1 },
            "rule": { "type": "string" }
          },
          "required": ["minRevisions", "rule"],
          "additionalProperties": false
        },
        "commits": {
          "type": "object",
          "description": "Commits of the logical changes that touched the selected files. Skipped commits are counted by cause and are not in any row.",
          "properties": {
            "inWindow": {
              "$ref": "#/$defs/count"
            },
            "analysed": {
              "$ref": "#/$defs/count"
            },
            "skipped": {
              "$ref": "#/$defs/count"
            },
            "skippedBy": {
              "type": "object",
              "properties": {
                "maxCommits": {
                  "$ref": "#/$defs/count",
                  "description": "Older commits beyond --max-commits."
                },
                "oversized": {
                  "$ref": "#/$defs/count",
                  "description": "Commits of changes with more files than history.maxChangesetSize."
                },
                "noSourceFile": {
                  "$ref": "#/$defs/count",
                  "description": "Commits that touched no file with a structural adapter that is analysed."
                }
              },
              "required": [
                "maxCommits",
                "oversized",
                "noSourceFile"
              ],
              "additionalProperties": false
            },
            "maxCommits": {
              "type": ["integer", "null"],
              "minimum": 1,
              "description": "The most commits analysed, newest first. Null analyses the whole window."
            }
          },
          "required": [
            "inWindow",
            "analysed",
            "skipped",
            "skippedBy",
            "maxCommits"
          ],
          "additionalProperties": false
        },
        "files": {
          "type": "object",
          "description": "File revisions the analysed commits changed, and the ones that could not be mapped onto functions, by cause.",
          "properties": {
            "analysed": {
              "$ref": "#/$defs/count"
            },
            "skipped": {
              "type": "object",
              "properties": {
                "binary": {
                  "$ref": "#/$defs/count"
                },
                "large": {
                  "$ref": "#/$defs/count"
                },
                "excluded": {
                  "$ref": "#/$defs/count"
                },
                "tests": {
                  "$ref": "#/$defs/count"
                },
                "noAdapter": {
                  "$ref": "#/$defs/count"
                }
              },
              "required": [
                "binary",
                "large",
                "excluded",
                "tests",
                "noAdapter"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "analysed",
            "skipped"
          ],
          "additionalProperties": false
        },
        "cache": {
          "type": "object",
          "description": "Blobs parsed in this run and blobs read from the parse cache. A rerun parses none it has parsed before.",
          "properties": {
            "parsed": {
              "$ref": "#/$defs/count"
            },
            "cached": {
              "$ref": "#/$defs/count"
            }
          },
          "required": [
            "parsed",
            "cached"
          ],
          "additionalProperties": false
        },
        "summary": {
          "type": "object",
          "properties": {
            "unitsTouched": {
              "$ref": "#/$defs/count",
              "description": "Functions with a changed line in the analysed window, deleted ones included."
            },
            "unitsWithFixes": {
              "$ref": "#/$defs/count"
            },
            "currentUnitsWithFixes": {
              "$ref": "#/$defs/count"
            }
          },
          "required": [
            "unitsTouched",
            "unitsWithFixes",
            "currentUnitsWithFixes"
          ],
          "additionalProperties": false
        },
        "deleted": {
          "type": "object",
          "description": "Functions touched in the window that are not in the current revision, listed apart from the rows.",
          "properties": {
            "units": {
              "$ref": "#/$defs/count"
            },
            "withFixes": {
              "$ref": "#/$defs/count"
            },
            "limit": {
              "type": "integer",
              "minimum": 1
            },
            "omitted": {
              "$ref": "#/$defs/count",
              "description": "Deleted functions with fixes beyond the limit."
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fixRow"
              }
            }
          },
          "required": [
            "units",
            "withFixes",
            "limit",
            "omitted",
            "rows"
          ],
          "additionalProperties": false
        },
        "outsideUnits": {
          "type": "object",
          "description": "Fixes that changed lines outside every function count against the file.",
          "properties": {
            "fixCommits": {
              "$ref": "#/$defs/count",
              "description": "Distinct fix changes with a changed line outside every function. Never more than the fixes of the window."
            },
            "fixFileChanges": {
              "$ref": "#/$defs/count",
              "description": "The same changes counted once per file they touched, which is the sum of the rows' fixCommits."
            },
            "files": {
              "$ref": "#/$defs/count"
            },
            "limit": {
              "type": "integer",
              "minimum": 1
            },
            "omitted": {
              "$ref": "#/$defs/count",
              "description": "Files beyond the limit."
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "fixCommits": {
                    "$ref": "#/$defs/count"
                  },
                  "revisions": {
                    "$ref": "#/$defs/count",
                    "description": "Changes with a changed line outside every function of the file."
                  }
                },
                "required": [
                  "path",
                  "fixCommits",
                  "revisions"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "fixCommits",
            "fixFileChanges",
            "files",
            "limit",
            "omitted",
            "rows"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "window",
        "shallow",
        "fixConvention",
        "fixesExcluded",
        "lowEvidence",
        "commits",
        "files",
        "cache",
        "summary",
        "deleted",
        "outsideUnits"
      ]
    }
  }
}
