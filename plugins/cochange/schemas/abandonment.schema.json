{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abandonment.schema.json",
  "title": "cochange abandonment <current> --json",
  "description": "Knowledge lost when people leave. Developers appear only as counts. The output is never stored as a report. `inputs.subcommand` says which shape `results` takes.",
  "$defs": {
    "inputs": {
      "type": "object",
      "properties": {
        "subcommand": { "enum": ["current"] },
        "by": { "enum": ["file", "component"] },
        "activityWindowMonths": { "type": "integer", "minimum": 1 },
        "periodMonths": { "type": "integer", "minimum": 1 },
        "abandonmentThreshold": { "type": "integer", "minimum": 1, "maximum": 100, "description": "Percentage of a file's lines held by people who have left at which it is abandoned." },
        "copyDetection": { "type": "boolean" },
        "overrides": {
          "type": "object",
          "description": "Counts of the local activity overrides in effect, and a hash of the file. Never identities.",
          "properties": {
            "active": { "$ref": "common.schema.json#/$defs/count" },
            "inactive": { "$ref": "common.schema.json#/$defs/count" },
            "hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{16}$" }
          },
          "required": ["active", "inactive", "hash"],
          "additionalProperties": false
        },
        "identityInputs": { "$ref": "common.schema.json#/$defs/identityInputs" }
      },
      "required": ["subcommand", "activityWindowMonths", "periodMonths", "abandonmentThreshold", "copyDetection", "overrides"],
      "additionalProperties": false
    },
    "currentSummary": {
      "type": "object",
      "description": "With `current`: the repository as a whole.",
      "properties": {
        "files": {
          "type": "object",
          "properties": {
            "measured": { "$ref": "common.schema.json#/$defs/count", "description": "Files with at least one line held by a person." },
            "abandoned": { "$ref": "common.schema.json#/$defs/count" },
            "share": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["measured", "abandoned", "share"],
          "additionalProperties": false
        },
        "lines": {
          "type": "object",
          "properties": {
            "people": { "$ref": "common.schema.json#/$defs/count", "description": "Lines held by people." },
            "abandoned": { "$ref": "common.schema.json#/$defs/count", "description": "Of those, lines whose last author has left." },
            "share": { "type": "number", "minimum": 0, "maximum": 1 },
            "nonPerson": { "$ref": "common.schema.json#/$defs/count", "description": "Lines of bots, services and agents. They belong to nobody and are on neither side of the share." },
            "unattributed": { "$ref": "common.schema.json#/$defs/count" }
          },
          "required": ["people", "abandoned", "share", "nonPerson", "unattributed"],
          "additionalProperties": false
        }
      },
      "required": ["files", "lines"],
      "additionalProperties": false
    },
    "currentFile": {
      "description": "A file already abandoned (`--by file`).",
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "score": { "$ref": "common.schema.json#/$defs/count", "description": "The abandoned lines: what the list is ranked by." },
        "abandonedShare": { "type": "number", "minimum": 0, "maximum": 1 },
        "abandonedLines": { "$ref": "common.schema.json#/$defs/count" },
        "peopleLines": { "$ref": "common.schema.json#/$defs/count" },
        "activeAuthors": { "$ref": "common.schema.json#/$defs/count" },
        "formerAuthors": { "$ref": "common.schema.json#/$defs/count" },
        "nonPersonLines": { "$ref": "common.schema.json#/$defs/count" }
      },
      "required": ["path", "score", "abandonedShare", "abandonedLines", "peopleLines", "activeAuthors", "formerAuthors", "nonPersonLines"],
      "additionalProperties": false
    },
    "currentComponent": {
      "description": "A component with abandoned lines (`--by component`).",
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 1, "description": "The abandoned share: what the list is ranked by." },
        "files": { "$ref": "common.schema.json#/$defs/count" },
        "abandonedFiles": { "$ref": "common.schema.json#/$defs/count" },
        "abandonedShare": { "type": "number", "minimum": 0, "maximum": 1 },
        "abandonedLines": { "$ref": "common.schema.json#/$defs/count" },
        "peopleLines": { "$ref": "common.schema.json#/$defs/count" }
      },
      "required": ["path", "score", "files", "abandonedFiles", "abandonedShare", "abandonedLines", "peopleLines"],
      "additionalProperties": false
    }
  },
  "allOf": [{ "$ref": "common.schema.json#/$defs/analysisEnvelope" }],
  "type": "object",
  "properties": {
    "command": { "const": "abandonment" },
    "inputs": { "$ref": "#/$defs/inputs" },
    "developers": {
      "type": "object",
      "description": "People in the history, as counts: active at the analysed commit (after overrides) and not.",
      "properties": { "active": { "$ref": "common.schema.json#/$defs/count" }, "inactive": { "$ref": "common.schema.json#/$defs/count" } },
      "required": ["active", "inactive"],
      "additionalProperties": false
    },
    "blame": {
      "type": "object",
      "properties": {
        "unknownFiles": { "$ref": "common.schema.json#/$defs/count", "description": "Authored files the blame cache holds nothing right for. Their authorship is unknown, not zero." },
        "unattributedLines": { "$ref": "common.schema.json#/$defs/count", "description": "Lines whose commit is unknown, for example beyond a shallow boundary." }
      },
      "required": ["unknownFiles", "unattributedLines"],
      "additionalProperties": false
    },
    "summary": { "$ref": "#/$defs/currentSummary" },
    "results": {}
  },
  "required": ["developers", "blame"],
  "oneOf": [
    {
      "properties": {
        "inputs": {
          "type": "object",
          "properties": { "subcommand": { "const": "current" }, "by": true },
          "required": ["subcommand", "by"]
        },
        "results": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/currentFile" }, { "$ref": "#/$defs/currentComponent" }] } },
        "summary": true
      },
      "required": ["inputs", "summary"]
    }
  ],
  "unevaluatedProperties": false
}
