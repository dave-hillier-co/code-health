{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions for cochange --json output",
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "count": { "type": "integer", "minimum": 0 },
    "repo": {
      "type": "object",
      "properties": { "head": { "$ref": "#/$defs/sha" }, "dirty": { "type": "boolean" } },
      "required": ["head", "dirty"],
      "additionalProperties": false
    },
    "truncated": {
      "type": "object",
      "properties": {
        "limit": { "type": ["integer", "null"], "minimum": 1 },
        "total": { "type": ["integer", "null"], "minimum": 0 },
        "cut": { "$ref": "#/$defs/count" }
      },
      "required": ["limit", "total", "cut"],
      "additionalProperties": false
    },
    "envelope": {
      "description": "Fields every document has. A command schema adds its own `command` and `results` and closes the document with unevaluatedProperties.",
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 1 },
        "tool": { "const": "cochange" },
        "command": { "type": "string" },
        "repo": { "$ref": "#/$defs/repo" },
        "config": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "inputs": { "type": "object" },
        "results": {},
        "truncated": { "$ref": "#/$defs/truncated" },
        "meta": {
          "description": "Wall-clock facts. Absent from reports and ignored by golden comparisons.",
          "type": "object"
        }
      },
      "required": ["schemaVersion", "tool", "command", "repo", "config", "inputs", "results", "truncated"]
    },
    "window": {
      "description": "What the results were limited to. `until` is the analysed commit's committer date, never the wall clock.",
      "type": "object",
      "properties": {
        "since": { "type": "string", "format": "date-time" },
        "until": { "type": "string", "format": "date-time" }
      },
      "required": ["since", "until"],
      "additionalProperties": false
    },
    "filtersApplied": {
      "type": "object",
      "properties": {
        "excludeGlobs": { "type": "array", "items": { "type": "string" } },
        "lockfiles": { "type": "boolean" },
        "gitattributes": { "type": "boolean" },
        "blameIgnoreRevs": { "type": ["string", "null"] },
        "botPatterns": { "type": "array", "items": { "type": "string" }, "description": "The configured patterns only." },
        "nonPerson": {
          "type": "object",
          "description": "The built-in patterns, configured service patterns and reviewed decisions that also drop commits, counted with the others in dropped.botCommits. Empty when no classification applied.",
          "properties": {
            "builtinBotPatterns": { "type": "array", "items": { "type": "string" } },
            "builtinServiceNames": { "type": "array", "items": { "type": "string" } },
            "servicePatterns": { "type": "array", "items": { "type": "string" } },
            "decisions": { "type": "integer", "minimum": 0 }
          },
          "required": ["builtinBotPatterns", "builtinServiceNames", "servicePatterns", "decisions"],
          "additionalProperties": false
        },
        "maxChangesetSize": { "type": "integer", "minimum": 1 },
        "excludeImported": { "type": "boolean" },
        "excludeSuiteCommits": { "type": "boolean" },
        "grouping": {
          "type": "object",
          "description": "How commits formed logical changes.",
          "properties": {
            "mode": { "enum": ["off", "issue-key", "author-window"] },
            "issuePattern": { "type": ["string", "null"], "description": "The regular expression whose match is the issue key. Only with issue-key." },
            "windowSeconds": { "type": ["integer", "null"], "minimum": 1, "description": "The longest pause between commits of one change: with author-window the configured window, with issue-key the longest gap between commits sharing a key." },
            "mergedCommits": { "$ref": "#/$defs/count", "description": "Commits folded into another logical change." }
          },
          "required": ["mode", "issuePattern", "windowSeconds", "mergedCommits"],
          "additionalProperties": false
        },
        "dropped": {
          "type": "object",
          "properties": {
            "outsideWindow": { "$ref": "#/$defs/count" },
            "shallowBoundaryCommits": { "$ref": "#/$defs/count" },
            "importedCommits": { "$ref": "#/$defs/count" },
            "blameIgnoredCommits": { "$ref": "#/$defs/count" },
            "botCommits": { "$ref": "#/$defs/count" },
            "suiteCommits": { "$ref": "#/$defs/count" },
            "pureRenames": { "$ref": "#/$defs/count" },
            "excludedByGlob": { "$ref": "#/$defs/count" },
            "lockfiles": { "$ref": "#/$defs/count" },
            "generated": { "$ref": "#/$defs/count" },
            "vendored": { "$ref": "#/$defs/count" },
            "emptyAfterFiltering": { "$ref": "#/$defs/count" }
          },
          "required": [
            "outsideWindow",
            "shallowBoundaryCommits",
            "importedCommits",
            "blameIgnoredCommits",
            "botCommits",
            "suiteCommits",
            "pureRenames",
            "excludedByGlob",
            "lockfiles",
            "generated",
            "vendored",
            "emptyAfterFiltering"
          ],
          "additionalProperties": false
        },
        "oversizedChanges": { "$ref": "#/$defs/count" }
      },
      "required": [
        "excludeGlobs",
        "lockfiles",
        "gitattributes",
        "blameIgnoreRevs",
        "botPatterns",
        "nonPerson",
        "maxChangesetSize",
        "excludeImported",
        "excludeSuiteCommits",
        "grouping",
        "dropped",
        "oversizedChanges"
      ],
      "additionalProperties": false
    },
    "gradeGuideline": {
      "type": "object",
      "properties": {
        "months": { "type": "number", "minimum": 0 },
        "logicalChanges": { "$ref": "#/$defs/count" },
        "contributors": { "$ref": "#/$defs/count" }
      },
      "required": ["months", "logicalChanges", "contributors"],
      "additionalProperties": false
    },
    "evidence": {
      "description": "How much to trust anything computed from history: the suite's repository-level evidence block.",
      "type": "object",
      "properties": {
        "usableHistoryMonths": { "type": "number", "minimum": 0 },
        "logicalChangesInWindow": { "$ref": "#/$defs/count" },
        "activeContributors": { "$ref": "#/$defs/count" },
        "grade": { "enum": ["strong", "moderate", "weak"] },
        "window": {
          "description": "The grading window, in unix seconds.",
          "type": "object",
          "properties": {
            "months": { "type": "integer", "minimum": 1 },
            "since": { "type": "integer" },
            "until": { "type": "integer" }
          },
          "required": ["months", "since", "until"],
          "additionalProperties": false
        },
        "truncated": {
          "type": "object",
          "properties": {
            "shallow": { "type": "boolean" },
            "boundaryCommits": { "$ref": "#/$defs/count" },
            "availableSince": { "type": ["integer", "null"] }
          },
          "required": ["shallow", "boundaryCommits", "availableSince"],
          "additionalProperties": false
        },
        "importedHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sha": { "$ref": "#/$defs/sha" },
              "files": { "$ref": "#/$defs/count" },
              "share": { "type": "number", "minimum": 0, "maximum": 1 },
              "committerDate": { "type": "integer" }
            },
            "required": ["sha", "files", "share", "committerDate"],
            "additionalProperties": false
          }
        },
        "commitSize": {
          "type": "object",
          "properties": {
            "earlierMedian": { "type": "number", "minimum": 0 },
            "laterMedian": { "type": "number", "minimum": 0 },
            "shifted": { "type": "boolean" }
          },
          "required": ["earlierMedian", "laterMedian", "shifted"],
          "additionalProperties": false
        },
        "guidelines": {
          "type": "object",
          "properties": {
            "strong": { "$ref": "#/$defs/gradeGuideline" },
            "moderate": { "$ref": "#/$defs/gradeGuideline" }
          },
          "required": ["strong", "moderate"],
          "additionalProperties": false
        }
      },
      "required": [
        "usableHistoryMonths",
        "logicalChangesInWindow",
        "activeContributors",
        "grade",
        "window",
        "truncated",
        "importedHistory",
        "commitSize",
        "guidelines"
      ],
      "additionalProperties": false
    },
    "identityInputs": {
      "description": "Present when identity decisions or a local-only mailmap shaped the results: a short hash of each file, since results depend on them beyond the repository, config and history.",
      "type": "object",
      "properties": {
        "decisions": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "localMailmap": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      },
      "additionalProperties": false
    },
    "analysisEnvelope": {
      "description": "The envelope plus the sections every command that reads history adds. A command schema allOf-references this and closes the document with unevaluatedProperties.",
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "type": "object",
      "properties": {
        "window": { "$ref": "#/$defs/window" },
        "filtersApplied": { "$ref": "#/$defs/filtersApplied" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["window", "filtersApplied", "evidence"]
    },
    "fixConvention": {
      "description": "The repository-level check on the fix definition: the share of logical changes in the window that are fixes. A note says the commit messages probably do not follow a convention this can use. The counts are reported either way.",
      "type": "object",
      "properties": {
        "logicalChanges": {
          "type": "integer",
          "minimum": 0
        },
        "fixes": {
          "type": "integer",
          "minimum": 0
        },
        "share": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "followsConvention": {
          "type": "boolean"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "guidelines": {
          "type": "object",
          "properties": {
            "minShare": {
              "type": "number"
            },
            "maxShare": {
              "type": "number"
            },
            "minChanges": {
              "type": "integer"
            },
            "provenance": {
              "type": "string"
            }
          },
          "required": [
            "minShare",
            "maxShare",
            "minChanges",
            "provenance"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "logicalChanges",
        "fixes",
        "share",
        "followsConvention",
        "note",
        "guidelines"
      ],
      "additionalProperties": false
    }
  }
}
