{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "packages.schema.json",
  "title": "structure packages --json",
  "description": "One schema for every `structure packages` subcommand. `inputs.subcommand` says which, and selects the shape of `results`.",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/analysisEnvelope"
    },
    {
      "if": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": {
              "subcommand": {
                "const": "list"
              }
            },
            "required": [
              "subcommand"
            ]
          }
        },
        "required": [
          "inputs"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": {
              "subcommand": {
                "const": "list"
              },
              "graceDays": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "subcommand",
              "graceDays"
            ],
            "additionalProperties": false
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/packageRow"
            }
          },
          "repository": {
            "$ref": "#/$defs/repository"
          }
        },
        "required": [
          "repository"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": {
              "subcommand": {
                "const": "cohesion"
              }
            },
            "required": [
              "subcommand"
            ]
          }
        },
        "required": [
          "inputs"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": {
              "subcommand": {
                "const": "cohesion"
              },
              "package": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "subcommand",
              "package"
            ],
            "additionalProperties": false
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/finding"
            }
          },
          "balance": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/balance"
            }
          },
          "unavailable": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/unavailable"
            }
          }
        },
        "required": [
          "balance",
          "unavailable"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": {
              "subcommand": {
                "const": "boundaries"
              }
            },
            "required": [
              "subcommand"
            ]
          }
        },
        "required": [
          "inputs"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": {
              "subcommand": {
                "const": "boundaries"
              },
              "package": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "subcommand",
              "package"
            ],
            "additionalProperties": false
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/finding"
            }
          },
          "unavailable": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/unavailable"
            }
          }
        },
        "required": [
          "unavailable"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": {
              "subcommand": {
                "const": "coupling"
              }
            },
            "required": [
              "subcommand"
            ]
          }
        },
        "required": [
          "inputs"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": {
              "subcommand": {
                "const": "coupling"
              },
              "minRevisions": {
                "type": "integer",
                "minimum": 1
              },
              "minVolatilityRatio": {
                "type": "integer",
                "minimum": 1
              },
              "minInstabilityGap": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "required": [
              "subcommand",
              "minRevisions",
              "minVolatilityRatio",
              "minInstabilityGap"
            ],
            "additionalProperties": false
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/finding"
            }
          }
        },
        "required": []
      }
    }
  ],
  "type": "object",
  "properties": {
    "command": {
      "const": "packages"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "subcommand": {
          "enum": [
            "list",
            "cohesion",
            "boundaries",
            "coupling"
          ]
        }
      },
      "required": [
        "subcommand"
      ]
    },
    "repository": true,
    "balance": true,
    "unavailable": true
  },
  "required": [
    "inputs"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "balance": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "matters": {
          "enum": [
            "closure",
            "reuse",
            "release",
            "tentative",
            "mixed"
          ]
        },
        "closure": {
          "type": "object",
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "share": {
              "type": "number"
            },
            "crossing": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "changesWith": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "value",
            "share",
            "crossing",
            "changesWith"
          ],
          "additionalProperties": false
        },
        "reuse": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "surface": {
                  "$ref": "common.schema.json#/$defs/count"
                },
                "consumers": {
                  "$ref": "common.schema.json#/$defs/count"
                },
                "medianShare": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "components": {
                  "$ref": "common.schema.json#/$defs/count"
                },
                "unused": {
                  "$ref": "common.schema.json#/$defs/count"
                }
              },
              "required": [
                "surface",
                "consumers",
                "medianShare",
                "components",
                "unused"
              ],
              "additionalProperties": false
            }
          ]
        },
        "release": {
          "type": "object",
          "properties": {
            "consumers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "published": {
              "type": "boolean"
            },
            "deployables": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "versionChanges": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "common.schema.json#/$defs/count"
                }
              ]
            },
            "young": {
              "type": "boolean"
            }
          },
          "required": [
            "consumers",
            "published",
            "deployables",
            "versionChanges",
            "young"
          ],
          "additionalProperties": false
        },
        "neglected": {
          "type": "array",
          "items": {
            "enum": [
              "CCP",
              "CRP",
              "REP"
            ]
          }
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "reading": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "matters",
        "closure",
        "reuse",
        "release",
        "neglected",
        "cost",
        "reading"
      ],
      "additionalProperties": false
    },
    "unavailable": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "package",
        "reason",
        "findings"
      ],
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "properties": {
        "packages": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "ecosystems": {
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/count"
          }
        },
        "eligibleChanges": {
          "$ref": "common.schema.json#/$defs/count"
        }
      },
      "required": [
        "packages",
        "ecosystems",
        "eligibleChanges"
      ],
      "additionalProperties": false
    },
    "packageRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "ecosystem": {
          "enum": [
            "npm",
            "dotnet",
            "cmake",
            "gradle",
            "maven",
            "python",
            "cargo",
            "go",
            "component"
          ]
        },
        "kind": {
          "enum": [
            "internal",
            "published"
          ]
        },
        "purpose": {
          "enum": [
            "reuse",
            "deploy",
            "ownership",
            "build",
            "enforcement",
            null
          ]
        },
        "entry": {
          "type": "boolean"
        },
        "testSupport": {
          "type": "boolean"
        },
        "files": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ca": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "ce": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "instability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "abstractness": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "distance": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "closure": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "crossing": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "revisions": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "firstSeen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "young": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "ecosystem",
        "kind",
        "purpose",
        "entry",
        "testSupport",
        "files",
        "consumers",
        "dependencies",
        "ca",
        "ce",
        "instability",
        "abstractness",
        "distance",
        "closure",
        "share",
        "crossing",
        "revisions",
        "firstSeen",
        "young"
      ],
      "additionalProperties": false
    },
    "figure": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "principle": {
          "enum": [
            "CCP",
            "CRP",
            "REP",
            "ADP",
            "SDP",
            "SAP",
            "boundary"
          ]
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/figure"
          }
        },
        "changeCost": {
          "type": "number",
          "minimum": 0
        },
        "tentative": {
          "type": "boolean"
        },
        "priority": {
          "enum": [
            "normal",
            "low"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "principle",
        "packages",
        "unit",
        "summary",
        "evidence",
        "changeCost",
        "tentative",
        "priority"
      ],
      "additionalProperties": false
    }
  }
}
