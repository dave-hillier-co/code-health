{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cycles.schema.json",
  "title": "structure cycles --json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/analysisEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "command": {
      "const": "cycles"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "file",
            "folder",
            "package"
          ]
        },
        "exactLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "locality": {
          "$ref": "common.schema.json#/$defs/localityInput"
        }
      },
      "required": [
        "level",
        "exactLimit",
        "locality"
      ],
      "additionalProperties": false
    },
    "population": {
      "type": "object",
      "properties": {
        "modules": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "eligibleChanges": {
          "$ref": "common.schema.json#/$defs/count"
        }
      },
      "required": [
        "modules",
        "eligibleChanges"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^cycle:(file|folder|package):.+"
          },
          "level": {
            "enum": [
              "file",
              "folder",
              "package"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "nested": {
            "type": "boolean",
            "description": "A folder cycle whose folders all lie on one path from the root, such as a folder and its child. Sorted after cycles with nested false. Always false at other levels."
          },
          "method": {
            "enum": [
              "exact",
              "heuristic"
            ],
            "description": "`exact` is a minimum feedback arc set. `heuristic` is Eades-Lin-Smyth, pruned to a minimal set."
          },
          "breakingSet": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/breakingEdge"
            },
            "minItems": 1
          },
          "coChangeAcross": {
            "$ref": "common.schema.json#/$defs/count"
          },
          "unblockedGain": {
            "type": [
              "number",
              "null"
            ],
            "description": "Null without a matching locality report."
          }
        },
        "required": [
          "id",
          "level",
          "size",
          "nodes",
          "nested",
          "method",
          "breakingSet",
          "coChangeAcross",
          "unblockedGain"
        ],
        "additionalProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
