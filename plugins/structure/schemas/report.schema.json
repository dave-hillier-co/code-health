{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.schema.json",
  "title": "structure report <kind> --slots",
  "description": "The document `report <kind> --slots` prints: the report's data and the judgement slots. It is not wrapped in the usual envelope. The notes file a report is rendered from is `{ stamp, notes }`, where `stamp` is copied unchanged and `notes` has one entry per slot id.",
  "type": "object",
  "properties": {
    "protocol": { "const": 1, "description": "The version of the slots and notes documents." },
    "report": { "type": "string", "description": "The report kind, the word typed after `report`." },
    "stamp": { "$ref": "#/$defs/stamp" },
    "data": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "header": {
          "type": "object",
          "properties": {
            "repo": { "type": "string" },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "HEAD's committer date. The wall clock never appears." },
            "configHash": { "type": "string" },
            "evidenceGrade": { "type": "string" },
            "historyWindow": { "type": "string" },
            "excluded": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": { "what": { "type": "string" }, "count": { "type": "integer", "minimum": 0 } },
                "required": ["what", "count"],
                "additionalProperties": false
              }
            }
          },
          "required": ["repo", "commit", "date", "configHash", "evidenceGrade", "historyWindow", "excluded"],
          "additionalProperties": false
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "heading": { "type": "string" },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": ["paragraph", "facts", "ranked-table", "treemap", "category-treemap", "sparkline", "histogram", "scatter", "matrix", "function-bars", "move-map", "guideline-bars", "stability-chart", "trend-marker", "evidence-list", "notice", "judgement", "judged-items"]
                    }
                  },
                  "required": ["type"]
                }
              }
            },
            "required": ["id", "heading", "blocks"],
            "additionalProperties": false
          }
        },
        "limits": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "header", "sections", "limits"],
      "additionalProperties": false
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "about": {
            "type": "object",
            "properties": {
              "kind": { "enum": ["file", "pair", "unit", "finding", "report"] },
              "ref": { "type": "string" },
              "label": { "type": "string" }
            },
            "required": ["kind", "ref", "label"],
            "additionalProperties": false
          },
          "task": { "type": "string", "description": "What to write." },
          "verdicts": { "type": "array", "items": { "type": "string" }, "description": "The allowed verdicts. Empty when the slot takes text only." },
          "maxChars": { "type": "integer", "minimum": 1 },
          "choose": {
            "type": "object",
            "properties": {
              "max": { "type": "integer", "minimum": 1 },
              "candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "ref": { "type": "string" }, "label": { "type": "string" } },
                  "required": ["ref", "label"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["max", "candidates"],
            "additionalProperties": false
          }
        },
        "required": ["id", "title", "about", "task", "verdicts", "maxChars"],
        "additionalProperties": false
      }
    },
    "instructions": { "type": "string" }
  },
  "required": ["protocol", "report", "stamp", "data", "slots", "instructions"],
  "additionalProperties": false,
  "$defs": {
    "stamp": {
      "type": "object",
      "properties": {
        "protocol": { "const": 1 },
        "kind": { "type": "string" },
        "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "config": { "type": "string" },
        "inputs": { "type": "object" }
      },
      "required": ["protocol", "kind", "head", "config", "inputs"],
      "additionalProperties": false
    }
  }
}
