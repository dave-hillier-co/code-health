{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hidden.schema.json",
  "title": "structure hidden --json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/analysisEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "command": {
      "const": "hidden"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "level": {
          "$ref": "common.schema.json#/$defs/level"
        },
        "quadrant": {
          "enum": [
            "hidden"
          ]
        },
        "minStaticCoupling": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "minSupport": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "minAgentTasks": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "minRevisions": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "significanceLevel": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "transcripts": {
          "type": "boolean",
          "description": "Session transcripts were read (--projects-dir), so incidental pairs carry agent reads."
        },
        "transcriptStamp": {
          "type": ["string", "null"],
          "description": "A stamp of the tasks read from the session transcripts, so two runs over different session folders are told apart. Null when none were read."
        }
      },
      "required": [
        "level",
        "quadrant",
        "minStaticCoupling",
        "minSupport",
        "minAgentTasks",
        "minRevisions",
        "significanceLevel",
        "transcripts",
        "transcriptStamp"
      ],
      "additionalProperties": false
    },
    "population": {
      "type": "object",
      "properties": {
        "modules": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "eligibleChanges": {
          "$ref": "common.schema.json#/$defs/count"
        }
      },
      "required": [
        "modules",
        "eligibleChanges"
      ],
      "additionalProperties": false
    },
    "quadrants": {
      "type": "object",
      "description": "Pairs in each quadrant before --quadrant filtered them.",
      "properties": {
        "real": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "incidental": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "hidden": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "stable": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "independent": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "insufficient-evidence": {
          "$ref": "common.schema.json#/$defs/count"
        }
      },
      "required": [
        "real",
        "incidental",
        "hidden",
        "stable",
        "independent",
        "insufficient-evidence"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^coupling:(file|folder|component):.+->.+"
          },
          "level": {
            "$ref": "common.schema.json#/$defs/level"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "quadrant": {
            "enum": [
              "real",
              "incidental",
              "hidden",
              "stable",
              "independent",
              "insufficient-evidence"
            ]
          },
          "staticCoupling": {
            "type": "object",
            "description": "Reference sites and distinct symbols of the other side's code across the boundary, both directions together.",
            "properties": {
              "sites": {
                "$ref": "common.schema.json#/$defs/count"
              },
              "symbols": {
                "$ref": "common.schema.json#/$defs/count"
              },
              "fromTo": {
                "$ref": "common.schema.json#/$defs/count"
              },
              "toFrom": {
                "$ref": "common.schema.json#/$defs/count"
              },
              "high": {
                "type": "boolean"
              }
            },
            "required": [
              "sites",
              "symbols",
              "fromTo",
              "toFrom",
              "high"
            ],
            "additionalProperties": false
          },
          "coChange": {
            "type": "object",
            "properties": {
              "shared": {
                "$ref": "common.schema.json#/$defs/count"
              },
              "fromChanges": {
                "$ref": "common.schema.json#/$defs/count"
              },
              "toChanges": {
                "$ref": "common.schema.json#/$defs/count"
              },
              "expected": {
                "type": "number",
                "minimum": 0,
                "description": "What independence predicts: fromChanges * toChanges / eligible changes."
              },
              "pValue": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "One-sided exact test, rounded to six places, so a very small value reads 0."
              },
              "high": {
                "type": "boolean",
                "description": "Support clears minSupport and the count is significantly above expected."
              }
            },
            "required": [
              "shared",
              "fromChanges",
              "toChanges",
              "expected",
              "pValue",
              "high"
            ],
            "additionalProperties": false
          },
          "bothActive": {
            "type": "boolean"
          },
          "incidental": {
            "type": "object",
            "description": "Incidental pairs only. Incidental coupling ranks low on its own and high when it blocks a locality move, is part of a cycle, violates a layer rule, or burdens agents with reads.",
            "properties": {
              "rank": {
                "enum": [
                  "high",
                  "low"
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "enum": [
                    "blocks-locality-move",
                    "in-cycle",
                    "layer-violation",
                    "agent-reads"
                  ]
                }
              },
              "agentReads": {
                "description": "Tasks that edited one side and opened the other only to follow the dependency. Null when no transcripts were read.",
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "rank",
              "reasons",
              "agentReads"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "level",
          "from",
          "to",
          "quadrant",
          "staticCoupling",
          "coChange",
          "bothActive"
        ],
        "additionalProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
