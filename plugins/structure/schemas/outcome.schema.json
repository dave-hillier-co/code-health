{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome.schema.json",
  "title": "structure outcome --json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/analysisEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "command": {
      "const": "outcome"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "level": {
          "$ref": "common.schema.json#/$defs/level"
        },
        "at": {
          "type": "string"
        },
        "minStaticCoupling": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "minSupport": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "minRevisions": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "significanceLevel": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "transcripts": {
          "type": "boolean",
          "description": "Session transcripts were read (--projects-dir), so agentEffort is measured when any task touched either side."
        },
        "transcriptStamp": {
          "type": [
            "string",
            "null"
          ],
          "description": "A stamp of the tasks read from the session transcripts, so two runs over different session folders are told apart. Null when none were read."
        }
      },
      "required": [
        "target",
        "level",
        "at",
        "minStaticCoupling",
        "minSupport",
        "minRevisions",
        "significanceLevel",
        "transcripts",
        "transcriptStamp"
      ],
      "additionalProperties": false
    },
    "hiddenCreated": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A pair that dropped its static dependency across the break and kept its co-change.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^coupling:.+->.+"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "sitesBefore": {
            "$ref": "common.schema.json#/$defs/count"
          },
          "sitesAfter": {
            "$ref": "common.schema.json#/$defs/count"
          },
          "sharedBefore": {
            "$ref": "common.schema.json#/$defs/count"
          },
          "sharedAfter": {
            "$ref": "common.schema.json#/$defs/count"
          },
          "pValueAfter": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "sitesBefore",
          "sitesAfter",
          "sharedBefore",
          "sharedAfter",
          "pValueAfter"
        ],
        "additionalProperties": false
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^outcome:(file|folder|package|component):.+->.+"
          },
          "level": {
            "$ref": "common.schema.json#/$defs/level"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "break": {
            "type": "object",
            "properties": {
              "rev": {
                "type": "string"
              },
              "sha": {
                "$ref": "common.schema.json#/$defs/sha"
              },
              "parent": {
                "$ref": "common.schema.json#/$defs/sha"
              },
              "date": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "rev",
              "sha",
              "parent",
              "date"
            ],
            "additionalProperties": false
          },
          "window": {
            "type": "object",
            "description": "Two windows of the same length either side of the break. The break's own change is in neither.",
            "properties": {
              "before": {
                "type": "object",
                "properties": {
                  "since": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "until": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "since",
                  "until"
                ],
                "additionalProperties": false
              },
              "after": {
                "type": "object",
                "properties": {
                  "since": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "until": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "since",
                  "until"
                ],
                "additionalProperties": false
              },
              "seconds": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "before",
              "after",
              "seconds"
            ],
            "additionalProperties": false
          },
          "before": {
            "type": "object",
            "properties": {
              "quadrant": {
                "enum": [
                  "real",
                  "incidental",
                  "hidden",
                  "stable",
                  "independent",
                  "insufficient-evidence"
                ]
              },
              "staticCoupling": {
                "type": "object",
                "properties": {
                  "sites": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "symbols": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "fromTo": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "toFrom": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "high": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "sites",
                  "symbols",
                  "fromTo",
                  "toFrom",
                  "high"
                ],
                "additionalProperties": false
              },
              "coChange": {
                "type": "object",
                "properties": {
                  "shared": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "fromChanges": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "toChanges": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "expected": {
                    "type": "number",
                    "minimum": 0
                  },
                  "pValue": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Rounded to six places, so a very small value reads 0."
                  },
                  "high": {
                    "type": "boolean"
                  },
                  "confidenceFromTo": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "confidenceToFrom": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "shared",
                  "fromChanges",
                  "toChanges",
                  "expected",
                  "pValue",
                  "high",
                  "confidenceFromTo",
                  "confidenceToFrom"
                ],
                "additionalProperties": false
              },
              "bothActive": {
                "type": "boolean"
              }
            },
            "required": [
              "quadrant",
              "staticCoupling",
              "coChange",
              "bothActive"
            ],
            "additionalProperties": false
          },
          "after": {
            "type": "object",
            "properties": {
              "quadrant": {
                "enum": [
                  "real",
                  "incidental",
                  "hidden",
                  "stable",
                  "independent",
                  "insufficient-evidence"
                ]
              },
              "staticCoupling": {
                "type": "object",
                "properties": {
                  "sites": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "symbols": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "fromTo": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "toFrom": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "high": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "sites",
                  "symbols",
                  "fromTo",
                  "toFrom",
                  "high"
                ],
                "additionalProperties": false
              },
              "coChange": {
                "type": "object",
                "properties": {
                  "shared": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "fromChanges": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "toChanges": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "expected": {
                    "type": "number",
                    "minimum": 0
                  },
                  "pValue": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Rounded to six places, so a very small value reads 0."
                  },
                  "high": {
                    "type": "boolean"
                  },
                  "confidenceFromTo": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "confidenceToFrom": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "shared",
                  "fromChanges",
                  "toChanges",
                  "expected",
                  "pValue",
                  "high",
                  "confidenceFromTo",
                  "confidenceToFrom"
                ],
                "additionalProperties": false
              },
              "bothActive": {
                "type": "boolean"
              }
            },
            "required": [
              "quadrant",
              "staticCoupling",
              "coChange",
              "bothActive"
            ],
            "additionalProperties": false
          },
          "verdict": {
            "enum": [
              "broken",
              "hidden-not-broken",
              "unchanged",
              "co-change-reduced",
              "no-baseline",
              "insufficient-evidence"
            ]
          },
          "leading": {
            "type": "object",
            "description": "Leading indicators only: structure is cleaner, which says nothing about whether change got cheaper.",
            "properties": {
              "cycles": {
                "type": "object",
                "properties": {
                  "before": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "after": {
                    "$ref": "common.schema.json#/$defs/count"
                  }
                },
                "required": [
                  "before",
                  "after"
                ],
                "additionalProperties": false,
                "description": "Import cycles between modules of the level, at the break's parent and at the analysed commit."
              },
              "layerViolations": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "before": {
                        "$ref": "common.schema.json#/$defs/count"
                      },
                      "after": {
                        "$ref": "common.schema.json#/$defs/count"
                      }
                    },
                    "required": [
                      "before",
                      "after"
                    ],
                    "additionalProperties": false,
                    "description": "Imports that break a configured layer rule."
                  }
                ],
                "description": "Null when no layers are configured."
              }
            },
            "required": [
              "cycles",
              "layerViolations"
            ],
            "additionalProperties": false
          },
          "agentEffort": {
            "description": "Agent outcome: navigation did not get worse through indirection. Effort on tasks that edited either side, over the same two windows as the co-change.",
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "measured"
                  },
                  "before": {
                    "$ref": "#/$defs/effortSummary",
                    "description": "Per-task figures for the tasks (one user prompt and the agent turns after it) that edited a file of either side, in the window before the break. Only counts are kept."
                  },
                  "after": {
                    "$ref": "#/$defs/effortSummary",
                    "description": "The same after the break."
                  },
                  "comparison": {
                    "description": "The same tasks measured on a pair of modules that stayed statically coupled, matched to this pair by static coupling at the break's parent. Null when no such pair exists.",
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "pair": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "minItems": 2,
                            "maxItems": 2
                          },
                          "before": {
                            "$ref": "#/$defs/effortSummary"
                          },
                          "after": {
                            "$ref": "#/$defs/effortSummary"
                          }
                        },
                        "required": [
                          "pair",
                          "before",
                          "after"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "difference": {
                    "type": "object",
                    "description": "The acted-on change in mean per-task effort minus the comparison pair's change, so drift every part of the repository shared cancels. Negative: effort fell more here. Null where a figure is missing.",
                    "properties": {
                      "filesRead": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "tokens": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "filesRead",
                      "tokens"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "status",
                  "before",
                  "after",
                  "comparison",
                  "difference"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "not-measured"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "level",
          "from",
          "to",
          "break",
          "window",
          "before",
          "after",
          "verdict",
          "leading",
          "agentEffort"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "effortSummary": {
      "type": "object",
      "description": "Per-task figures for the tasks (one user prompt and the agent turns after it) that edited a file of either side. Only counts are kept.",
      "properties": {
        "tasks": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "filesRead": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "mean": {
                  "type": "number"
                },
                "median": {
                  "type": "number"
                }
              },
              "required": [
                "mean",
                "median"
              ],
              "additionalProperties": false
            }
          ]
        },
        "foldersVisited": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "mean": {
                  "type": "number"
                },
                "median": {
                  "type": "number"
                }
              },
              "required": [
                "mean",
                "median"
              ],
              "additionalProperties": false
            }
          ]
        },
        "reReads": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "mean": {
                  "type": "number"
                },
                "median": {
                  "type": "number"
                }
              },
              "required": [
                "mean",
                "median"
              ],
              "additionalProperties": false
            }
          ]
        },
        "edits": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "mean": {
                  "type": "number"
                },
                "median": {
                  "type": "number"
                }
              },
              "required": [
                "mean",
                "median"
              ],
              "additionalProperties": false
            }
          ]
        },
        "tokens": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "mean": {
                  "type": "number"
                },
                "median": {
                  "type": "number"
                }
              },
              "required": [
                "mean",
                "median"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "tasks",
        "filesRead",
        "foldersVisited",
        "reReads",
        "edits",
        "tokens"
      ],
      "additionalProperties": false
    }
  }
}
