{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "structure evidence --json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/analysisEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "command": {
      "const": "evidence"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "level": {
          "$ref": "common.schema.json#/$defs/level"
        },
        "locality": {
          "$ref": "common.schema.json#/$defs/localityInput"
        }
      },
      "required": [
        "target",
        "level",
        "locality"
      ],
      "additionalProperties": false
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "milestone": {
            "type": "integer"
          }
        },
        "required": [
          "field",
          "milestone"
        ],
        "additionalProperties": false
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Facts that bear on how to break one dependency. It carries no recommended technique.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^edge:(file|folder|package|component):.+->.+"
          },
          "kind": {
            "enum": [
              "cycle",
              "layer-violation",
              "unstable-dependency",
              null
            ],
            "description": "The first problem the edge is part of, null when it is no problem."
          },
          "kinds": {
            "type": "array",
            "items": {
              "enum": [
                "cycle",
                "layer-violation",
                "unstable-dependency"
              ]
            },
            "uniqueItems": true
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "level": {
            "$ref": "common.schema.json#/$defs/level"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "quadrant": {
            "type": "object",
            "description": "Where the pair sits in the coupling quadrants, with the figures behind it.",
            "properties": {
              "name": {
                "enum": [
                  "real",
                  "incidental",
                  "hidden",
                  "stable",
                  "independent",
                  "insufficient-evidence"
                ]
              },
              "staticCoupling": {
                "type": "object",
                "properties": {
                  "sites": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "symbols": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "fromTo": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "toFrom": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "high": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "sites",
                  "symbols",
                  "fromTo",
                  "toFrom",
                  "high"
                ],
                "additionalProperties": false
              },
              "coChange": {
                "type": "object",
                "properties": {
                  "shared": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "fromChanges": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "toChanges": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "expected": {
                    "type": "number",
                    "minimum": 0
                  },
                  "pValue": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "high": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "shared",
                  "fromChanges",
                  "toChanges",
                  "expected",
                  "pValue",
                  "high"
                ],
                "additionalProperties": false
              },
              "bothActive": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "staticCoupling",
              "coChange",
              "bothActive"
            ],
            "additionalProperties": false
          },
          "inBreakingSet": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Null when the edge is in no cycle."
          },
          "breakingSet": {
            "type": "array",
            "description": "Every symbol used across the boundary, most used first.",
            "items": {
              "type": "object",
              "properties": {
                "symbol": {
                  "type": "string"
                },
                "sites": {
                  "$ref": "common.schema.json#/$defs/count"
                },
                "kind": {
                  "enum": [
                    "call",
                    "reference"
                  ]
                },
                "usedBy": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "symbol",
                "sites",
                "kind",
                "usedBy"
              ],
              "additionalProperties": false
            }
          },
          "imports": {
            "type": "object",
            "properties": {
              "fileEdges": {
                "$ref": "common.schema.json#/$defs/count"
              },
              "importStatements": {
                "$ref": "common.schema.json#/$defs/count"
              },
              "typeOnly": {
                "type": "boolean"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "fileEdges",
              "importStatements",
              "typeOnly",
              "files"
            ],
            "additionalProperties": false
          },
          "stability": {
            "type": "object",
            "properties": {
              "from": {
                "$ref": "common.schema.json#/$defs/stability"
              },
              "to": {
                "$ref": "common.schema.json#/$defs/stability"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "stabilityVerdict": {
            "allOf": [
              {
                "$ref": "common.schema.json#/$defs/againstStability"
              }
            ],
            "type": "object",
            "unevaluatedProperties": false
          },
          "coChange": {
            "type": "object",
            "properties": {
              "shared": {
                "$ref": "common.schema.json#/$defs/count"
              },
              "fromChanges": {
                "$ref": "common.schema.json#/$defs/count"
              },
              "toChanges": {
                "$ref": "common.schema.json#/$defs/count"
              },
              "confidenceFromTo": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "confidenceToFrom": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "expected": {
                "type": "number",
                "minimum": 0,
                "description": "fromChanges * toChanges / eligibleChanges: the shared changes independence would predict."
              },
              "eligibleChanges": {
                "$ref": "common.schema.json#/$defs/count"
              }
            },
            "required": [
              "shared",
              "fromChanges",
              "toChanges",
              "confidenceFromTo",
              "confidenceToFrom",
              "expected",
              "eligibleChanges"
            ],
            "additionalProperties": false
          },
          "misplacement": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "symbol": {
                  "type": "string"
                },
                "consumerFiles": {
                  "$ref": "common.schema.json#/$defs/count"
                },
                "onFromSide": {
                  "$ref": "common.schema.json#/$defs/count"
                },
                "onToSide": {
                  "$ref": "common.schema.json#/$defs/count"
                },
                "elsewhere": {
                  "$ref": "common.schema.json#/$defs/count"
                },
                "mostlyOn": {
                  "enum": [
                    "from",
                    "to",
                    "split"
                  ]
                },
                "moveMayRemoveDependency": {
                  "type": "boolean"
                }
              },
              "required": [
                "symbol",
                "consumerFiles",
                "onFromSide",
                "onToSide",
                "elsewhere",
                "mostlyOn",
                "moveMayRemoveDependency"
              ],
              "additionalProperties": false
            }
          },
          "unblocks": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/unblock"
            }
          },
          "nearbyMechanisms": {
            "type": "array",
            "maxItems": 0,
            "description": "Deferred to the mechanism census milestone."
          },
          "layerRule": {
            "type": [
              "array",
              "null"
            ],
            "description": "The layer rules the edge's imports break, one entry per pair of layers. Null when it breaks none.",
            "items": {
              "type": "object",
              "properties": {
                "fromLayer": {
                  "type": "string"
                },
                "toLayer": {
                  "type": "string"
                },
                "allowed": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "fileEdges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "from": {
                        "type": "string"
                      },
                      "to": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "from",
                      "to"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "fromLayer",
                "toLayer",
                "allowed",
                "fileEdges"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "kind",
          "kinds",
          "findings",
          "level",
          "from",
          "to",
          "quadrant",
          "inBreakingSet",
          "breakingSet",
          "imports",
          "stability",
          "stabilityVerdict",
          "coChange",
          "misplacement",
          "unblocks",
          "nearbyMechanisms",
          "layerRule"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "deferred"
  ],
  "unevaluatedProperties": false
}
