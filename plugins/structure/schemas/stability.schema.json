{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stability.schema.json",
  "title": "structure stability --json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/analysisEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "command": {
      "const": "stability"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "by": {
          "enum": [
            "folder",
            "component"
          ]
        },
        "minRevisions": {
          "type": "integer",
          "minimum": 1
        },
        "minVolatilityRatio": {
          "type": "integer",
          "minimum": 1
        },
        "minInstabilityGap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Percentage points."
        },
        "minTargetFiles": {
          "type": "integer",
          "minimum": 1,
          "description": "Evidence floor: dependencies onto a module of fewer files are listed after the others."
        }
      },
      "required": [
        "by",
        "minRevisions",
        "minVolatilityRatio",
        "minInstabilityGap",
        "minTargetFiles"
      ],
      "additionalProperties": false
    },
    "belowTargetFloor": {
      "description": "Dependencies onto a module of fewer than minTargetFiles files. They are the last rows of results, and the structure report leaves them out.",
      "$ref": "common.schema.json#/$defs/count"
    },
    "units": {
      "description": "Stability of each module, the most volatile first, at most fifty.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "structural": {
            "$ref": "common.schema.json#/$defs/structuralStability"
          },
          "change": {
            "$ref": "common.schema.json#/$defs/changeStability"
          }
        },
        "required": [
          "id",
          "structural",
          "change"
        ],
        "additionalProperties": false
      }
    },
    "unitsTotal": {
      "$ref": "common.schema.json#/$defs/count"
    },
    "results": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/againstStability"
          }
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^unstable:(folder|component):.+->.+"
          },
          "level": {
            "enum": [
              "folder",
              "component"
            ]
          },
          "from": {
            "type": "string",
            "description": "The dependant."
          },
          "to": {
            "type": "string",
            "description": "What it depends on."
          },
          "fileEdges": {
            "$ref": "common.schema.json#/$defs/count"
          },
          "stability": {
            "type": "object",
            "properties": {
              "from": {
                "$ref": "common.schema.json#/$defs/stability"
              },
              "to": {
                "$ref": "common.schema.json#/$defs/stability"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "basis": true,
          "structuralAboveGuideline": true,
          "changeAboveGuideline": true,
          "volatilityRatio": true,
          "towardsLessStable": true,
          "aboveGuideline": true,
          "disagree": true
        },
        "required": [
          "id",
          "level",
          "from",
          "to",
          "fileEdges",
          "stability"
        ],
        "unevaluatedProperties": false
      }
    }
  },
  "required": [
    "belowTargetFloor",
    "units",
    "unitsTotal"
  ],
  "unevaluatedProperties": false
}
