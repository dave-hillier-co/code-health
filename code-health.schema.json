{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dave-hillier-co/code-health/main/code-health.schema.json",
  "title": "code-health.json",
  "description": "Settings of the code-health plugins: keys every plugin shares, and one section per plugin.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The JSON Schema of this file, for editors."
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Globs of files no plugin analyses. They add to the built-in excludes and do not replace them: .claude/**, .cache/**, .code-health/** and every directory below the repository root that is its own git checkout (it contains a .git file or directory: a linked worktree, a nested clone or a submodule) are always left out of source trees and history. `config explain` prints them with the source built-in, and commands report how many files each omitted."
    },
    "testPatterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Globs that decide which files are tests, laid over each language's own conventions (*_test.go, *Tests.cs, *.test.ts, src/test/, tests/ and the like). A match makes a file a test, an entry that starts with ! makes it production, and the last matching entry wins. Rankings list production code first and say how many tests they left out."
    },
    "languages": {
      "type": "object",
      "description": "File types the suite has no lexer profile for: file extension (no dot) to the name of a lexer profile. Per-function values of a mapped type are marked unverified.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "entryPoints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Globs of files that are entry points: code nothing in the repository imports and nothing may move."
    },
    "includeRoots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Directories, relative to the repository root, that C and C++ `#include` paths are written against (for `#include \"stage/Terrain.h\"` with the file at `src/stage/Terrain.h`, `src`). They are tried after the include directories of a compile_commands.json and before CMake's target include directories. With neither a compile_commands.json nor includeRoots, the directories are inferred from where the included files are."
    },
    "components": {
      "type": "object",
      "description": "Named groups of paths: component name to globs."
    },
    "vagueNames": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Folder and file names that say nothing about their content."
    },
    "history": {
      "type": "object",
      "properties": {
        "branch": {
          "default": null
        },
        "firstParent": {
          "type": "boolean",
          "default": false
        },
        "renameSimilarity": {
          "type": "number",
          "default": 50
        },
        "renameLimit": {
          "type": "number",
          "default": 1000
        },
        "windowMonths": {
          "type": "number",
          "default": 12
        },
        "maxChangesetSize": {
          "type": "number",
          "default": 30
        },
        "botPatterns": {
          "type": "array",
          "default": []
        },
        "fixPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "^fix(\\([^)]*\\))?!?:",
            "^merge .*\\b(fix|hotfix|bugfix)[/-]",
            "^(?:(?:[a-z]+(?:\\([^)]*\\))?!?|[a-z][a-z0-9]*-\\d+):\\s*)?(?:fix|fixes|fixed|fixing)\\b",
            "\\bto\\s+fix\\b",
            "\\bbug\\b",
            "\\bbugs\\b",
            "\\bbugfix\\b",
            "\\bhotfix\\b",
            "\\bdefect\\b",
            "\\bfix(?:es)?\\s+#\\d+",
            "^review\\s+fix(?:es)?\\b"
          ]
        },
        "fixExcludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "^(?:chore|ci|test|tests|docs|style|build|refactor|perf)(?:\\([^)]*\\))?!?:",
            "\\bfix(?:es|ed|ing)?\\W+(?:\\w+\\W+){0,2}?(?:typos?|typographical|spelling|lints?|linting|linters?|formatting|whitespace|prettier|eslint|gofmt)\\b"
          ]
        },
        "revertPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "^revert\\b"
          ]
        },
        "fixMatchBody": {
          "type": "boolean",
          "default": false
        },
        "evidence": {
          "type": "object",
          "properties": {
            "strong": {
              "type": "object",
              "properties": {
                "months": {
                  "type": "number",
                  "default": 24
                },
                "logicalChanges": {
                  "type": "number",
                  "default": 300
                },
                "contributors": {
                  "type": "number",
                  "default": 5
                }
              },
              "additionalProperties": false,
              "default": {
                "months": 24,
                "logicalChanges": 300,
                "contributors": 5
              }
            },
            "moderate": {
              "type": "object",
              "properties": {
                "months": {
                  "type": "number",
                  "default": 6
                },
                "logicalChanges": {
                  "type": "number",
                  "default": 50
                },
                "contributors": {
                  "type": "number",
                  "default": 2
                }
              },
              "additionalProperties": false,
              "default": {
                "months": 6,
                "logicalChanges": 50,
                "contributors": 2
              }
            }
          },
          "additionalProperties": false,
          "default": {
            "strong": {
              "months": 24,
              "logicalChanges": 300,
              "contributors": 5
            },
            "moderate": {
              "months": 6,
              "logicalChanges": 50,
              "contributors": 2
            }
          }
        }
      },
      "additionalProperties": false,
      "description": "How history is read, for every plugin that reads it. A plugin section may override any key it lists, and the plugin's own value wins over this one."
    },
